# Скопируйте в .env и заполните. Единственное ручное действие перед запуском.

# --- PostgreSQL (используется и контейнером БД, и бэкендом) ---
POSTGRES_USER=aispace
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aispace

# Хост "db" = имя сервиса в docker-compose. asyncpg — для async SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://aispace:change_me@db:5432/aispace

# --- Аутентификация ---
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret

# --- DeepSeek (разбор фразы на естественном языке) ---
DEEPSEEK_API_KEY=your_deepseek_api_key

# --- Стартовый админ (создаётся при первом запуске, если задан) ---
ADMIN_EMAIL=admin@aispace.local
ADMIN_PASSWORD=change_me_admin

# --- Порты хоста (менять, только если стандартные заняты другим проектом) ---
# BACKEND_PORT и VITE_API_URL должны совпадать по номеру порта.
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
